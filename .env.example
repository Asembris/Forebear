# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Optional: enables "Ask AI to label" triage of ambiguous citations (NVIDIA-hosted, OpenAI-compatible API).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Optional: investigation agent models, comma-separated, tried in order (default: nemotron-3-ultra, then mistral-large-4)
# FOREBEAR_AGENT_MODELS=nvidia/nemotron-3-ultra-550b-a55b,mistralai/mistral-large-4-1t-a52b
# Optional overrides
# FOREBEAR_DB=data/forebear.rl
# FOREBEAR_URL=http://127.0.0.1:8765
